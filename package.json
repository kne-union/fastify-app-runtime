{
  "name": "@kne/fastify-app-runtime",
  "version": "0.1.3",
  "description": "Fastify 应用运行时插件：前端托管、remote-module-config.json、健康检查与应用设置",
  "main": "index.js",
  "scripts": {
    "init": "husky",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "test": "mocha test/**/*.test.js",
    "test:coverage": "nyc --reporter=html --reporter=text mocha test/**/*.test.js",
    "prettier": "prettier --config .prettierrc --write '{libs/**/*,index,test/**/*}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged"
  },
  "lint-staged": {
    "{libs/**/*,index,test/**/*}.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "index.js",
    "libs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/fastify-app-runtime.git"
  },
  "keywords": [
    "fastify",
    "fastify-plugin",
    "remote-module-config",
    "module-federation",
    "health-check",
    "readiness",
    "app-config",
    "static",
    "spa"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/fastify-app-runtime/issues"
  },
  "homepage": "https://github.com/kne-union/fastify-app-runtime#readme",
  "dependencies": {
    "@kne/fastify-setting": "^0.1.0"
  },
  "peerDependencies": {
    "@fastify/static": "*",
    "@kne/fastify-namespace": "*",
    "@kne/fastify-sequelize": "*",
    "fastify-plugin": ">=4"
  },
  "devDependencies": {
    "@fastify/env": "^5.0.2",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@kne/fastify-namespace": "^1.2.1",
    "@kne/fastify-sequelize": "^4.0.5",
    "chai": "^6.3.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.1",
    "husky": "^9.0.11",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.3",
    "nyc": "^18.0.0",
    "prettier": "^3.2.5",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  }
}
